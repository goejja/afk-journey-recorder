{
  "name": "afk-journey-recorder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-only recorder for AFK Journey attempts",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint web",
    "db:init": "tsx scripts/db-init.ts",
    "import:reference": "tsx scripts/import-reference.ts",
    "import:artifact-images": "tsx scripts/import-artifact-images.ts",
    "query": "tsx scripts/query.ts",
    "scenario:estimate": "tsx scripts/scenario-estimate.ts",
    "backfill:pictures": "tsx scripts/backfill-pictures.ts",
    "learn:ranks": "tsx scripts/learn-ranks.ts",
    "dev": "concurrently -n api,web -c blue,green \"tsx watch src/server/index.ts\" \"vite --config web/vite.config.ts\"",
    "build": "vite build --config web/vite.config.ts",
    "start": "tsx src/server/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.14",
    "node-html-parser": "^9.0.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.3",
    "oxlint": "^1.93.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
